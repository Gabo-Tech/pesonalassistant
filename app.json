{
  "expo": {
    "name": "Assistant",
    "slug": "pesonalassistant",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "assistant",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.local.assistant"
    },
    "android": {
      "package": "com.local.assistant",
      "versionCode": 12,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#0C0C0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "llama.rn",
      "./plugins/withAssistantAndroid",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "largeHeap": true,
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Assistant needs your calendar to create and read your events on this device."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F4F1EA"
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Assistant reads your contacts only when you tap Import, and keeps a copy on this phone."
        }
      ]
    ],
    "extra": {
      "router": {}
    }
  }
}
